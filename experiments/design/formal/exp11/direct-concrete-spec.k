requires "evm.md"

module EXP11-CONCRETE-SPEC
    imports EVM

    claim [wrong-left-length]:
        <k> #execute => #halt ... </k>
        <mode> NORMAL </mode>
        <schedule> BYZANTIUM </schedule>
        <useGas> false </useGas>
        <callStack> .List </callStack>
        <memoryUsed> 0 </memoryUsed>
        <localMem> .Bytes </localMem>
        <wordStack> .WordStack </wordStack>
        <program> #parseByteStack("") </program>
        <jumpDests> #computeValidJumpDests(#parseByteStack("")) </jumpDests>
        <callData> #parseByteStack("") </callData>
        <pc> 0 => ?PC:Int </pc>
        <statusCode> .StatusCode => EVMC_REVERT </statusCode>
endmodule
