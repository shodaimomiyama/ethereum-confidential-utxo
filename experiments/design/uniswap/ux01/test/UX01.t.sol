pragma solidity ^0.8.23;
import "../src/UX01.sol";
interface Vm { function getCode(string calldata) external returns(bytes memory); function deal(address,uint256) external; function addr(uint256) external returns(address); function sign(uint256,bytes32) external returns(uint8,bytes32,bytes32); function warp(uint256) external; function recordLogs() external; function getRecordedLogs() external returns(Log[] memory); }
struct Log { bytes32[] topics; bytes data; address emitter; }
interface IR { function addLiquidityETH(address,uint,uint,uint,address,uint) external payable returns(uint,uint,uint); function getAmountsOut(uint,address[] calldata) external view returns(uint[] memory); }
interface IPair { function getReserves() external view returns(uint112,uint112,uint32); }
contract UX01Test {
 Vm constant vm=Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
 uint256 constant KEY=0xA11CE; uint256 constant V=0.006 ether; uint256 constant W=0.003 ether;
 bytes32 constant INPUT=keccak256("ux01-fixed-input");
 BoundaryPool pool; PaymentAdapter adapter; DemoUSD token; IR router; address owner; address recipient=address(0xB0B); address weth; address pair;
 function deploy(string memory name,bytes memory args) internal returns(address a) { bytes memory code=bytes.concat(vm.getCode(name),args); assembly { a:=create(0,add(code,32),mload(code)) } require(a!=address(0),"deploy"); }
 function setUp() public { vm.deal(address(this),1 ether); owner=vm.addr(KEY); address factory=deploy("UniswapV2Factory.sol:UniswapV2Factory",abi.encode(address(this))); weth=deploy("WETH9.sol:WETH9",""); address r=deploy("UniswapV2Router02.sol:UniswapV2Router02",abi.encode(factory,weth)); router=IR(r); token=new DemoUSD(); token.approve(r,type(uint256).max); router.addLiquidityETH{value:0.1 ether}(address(token),10_000 ether,1,1,address(this),block.timestamp+1000); pair=IFactory(factory).getPair(weth,address(token)); require(pair!=address(0),"pair"); pool=new BoundaryPool(); pool.seed{value:V}(INPUT,V); adapter=new PaymentAdapter(address(pool),r,address(token)); }
 function request() internal view returns(OperationRequest memory r) { r.kind=2; r.owner=owner; r.salt=keccak256("ux01-salt"); r.inputIds=new bytes32[](1); r.inputIds[0]=INPUT; r.outputs=new Output[](1); r.outputs[0]=Output(owner,1,2,1,hex"1234"); r.w=W; r.destination=address(adapter); }
 function terms(OperationRequest memory r) internal view returns(PaymentTerms memory t) { t.operationId=pool.operationId(r); t.owner=owner; t.ethAmount=W; t.token=address(token); t.minAmountOut=1; t.recipient=recipient; t.deadline=uint64(block.timestamp+600); }
 function sign(bytes32 digest) internal returns(bytes memory) { (uint8 v,bytes32 r,bytes32 s)=vm.sign(KEY,digest); return abi.encodePacked(r,s,v); }
 function callData(OperationRequest memory r,PaymentTerms memory t) internal returns(bytes memory) { BalanceProof memory bp; RangeProofV3[] memory rp=new RangeProofV3[](1); return abi.encodeCall(adapter.pay,(r,bp,rp,sign(pool.digest(r)),t,sign(adapter.paymentDigest(t)))); }
 function submit(bytes memory data) internal returns(bool ok,bytes memory ret) { (ok,ret)=address(adapter).call(data); }
 function stateHash() internal view returns(bytes32) { (uint112 x,uint112 y,)=IPair(pair).getReserves(); OperationRequest memory r=request(); bytes32 op=pool.operationId(r); bytes32 changeId=keccak256(abi.encode(pool.OUTPUT_ID_TAG(),op,uint256(0))); return keccak256(abi.encode(pool.spent(INPUT),pool.executed(op),pool.fixtureChangeValue(changeId),pool.changeOwner(changeId),pool.totalFixtureValue(),address(pool).balance,address(adapter).balance,x,y,IERC20View(weth).balanceOf(pair),token.balanceOf(pair),token.balanceOf(recipient))); }
 function rejectUnchanged(bytes memory data,bytes32 id) internal { bytes32 beforeHash=stateHash(); (bool ok,)=submit(data); require(!ok,"unexpected success"); require(stateHash()==beforeHash,"state changed"); require(!adapter.executedPayments(id),"marked success"); }
 function testSuccessFullSwapAndDelivery() public { OperationRequest memory r=request(); PaymentTerms memory t=terms(r); address[] memory path=new address[](2); path[0]=weth; path[1]=address(token); uint256 quote=router.getAmountsOut(W,path)[1]; uint256 beforeToken=token.balanceOf(recipient); uint256 pairWethBefore=IERC20View(weth).balanceOf(pair); uint256 pairTokenBefore=token.balanceOf(pair); (bool ok,bytes memory ret)=submit(callData(r,t)); require(ok,"payment failed"); (bytes32 id,uint256 amountOut)=abi.decode(ret,(bytes32,uint256)); require(id==adapter.paymentDigest(t) && amountOut==quote,"quote"); require(token.balanceOf(recipient)-beforeToken==amountOut,"delivery"); require(IERC20View(weth).balanceOf(pair)-pairWethBefore==W,"Pair WETH input"); require(pairTokenBefore-token.balanceOf(pair)==amountOut,"Pair token output"); require(pool.spent(INPUT) && pool.executed(t.operationId),"input"); bytes32 changeId=keccak256(abi.encode(pool.OUTPUT_ID_TAG(),t.operationId,uint256(0))); require(pool.fixtureChangeValue(changeId)==V-W && pool.changeOwner(changeId)==owner,"change"); require(address(pool).balance==V-W && pool.totalFixtureValue()==V-W,"pool accounting"); require(address(adapter).balance==0 && adapter.executedPayments(id),"adapter accounting"); }
 function testMutatingEverySignedFieldFailsAtomically() public { OperationRequest memory r=request(); PaymentTerms memory t=terms(r); bytes32 id=adapter.paymentDigest(t); bytes memory ps=sign(id); bytes memory bs=sign(pool.digest(r)); BalanceProof memory bp; RangeProofV3[] memory rp=new RangeProofV3[](1); for(uint8 i;i<7;i++){ PaymentTerms memory x=t; if(i==0)x.operationId=bytes32(uint256(x.operationId)+1); if(i==1)x.owner=address(0xBAD); if(i==2)x.ethAmount++; if(i==3)x.token=address(0xBAD); if(i==4)x.minAmountOut++; if(i==5)x.recipient=address(0xCAFE); if(i==6)x.deadline++; rejectUnchanged(abi.encodeCall(adapter.pay,(r,bp,rp,bs,x,ps)),id); } }
 function testPoolRequestMutationAndDetachedWithdrawalFail() public { OperationRequest memory r=request(); PaymentTerms memory t=terms(r); bytes32 id=adapter.paymentDigest(t); bytes memory ps=sign(id); bytes memory bs=sign(pool.digest(r)); BalanceProof memory bp; RangeProofV3[] memory rp=new RangeProofV3[](1); r.w++; rejectUnchanged(abi.encodeCall(adapter.pay,(r,bp,rp,bs,t,ps)),id); r=request(); r.destination=address(this); rejectUnchanged(abi.encodeCall(adapter.pay,(r,bp,rp,bs,t,ps)),id); r=request(); bytes32 beforeHash=stateHash(); (bool ok,)=address(pool).call(abi.encodeCall(pool.withdraw,(r,bp,rp,bs))); require(!ok && stateHash()==beforeHash,"detached withdrawal"); }
 function testMinOutputFailureRollsBackEverything() public { OperationRequest memory r=request(); PaymentTerms memory t=terms(r); t.minAmountOut=type(uint256).max; rejectUnchanged(callData(r,t),adapter.paymentDigest(t)); }
 function testDeadlineBoundaryAndExpiry() public { OperationRequest memory r=request(); PaymentTerms memory t=terms(r); vm.warp(t.deadline+1); rejectUnchanged(callData(r,t),adapter.paymentDigest(t)); vm.warp(t.deadline); (bool ok,)=submit(callData(r,t)); require(ok,"exact deadline"); }
 function testReplayAndCopiedSubmission() public { OperationRequest memory r=request(); PaymentTerms memory t=terms(r); bytes memory data=callData(r,t); (bool ok,)=submit(data); require(ok,"first"); bytes32 h=stateHash(); (ok,)=submit(data); require(!ok && stateHash()==h,"replay"); }
 function testReentrantPayAndOtherEntrypointsRejected() public { OperationRequest memory r=request(); PaymentTerms memory t=terms(r); bytes memory data=callData(r,t); pool.configureReentryProbes(data,false); uint256 beforeToken=token.balanceOf(recipient); (bool ok,)=submit(data); require(ok,"outer payment failed"); require(pool.payReentryRejected() && pool.fallbackReentryRejected() && pool.wrongEthReceiptRejected(),"a reentrant entry was not rejected"); require(pool.spent(INPUT) && pool.executed(t.operationId),"input not spent once"); require(adapter.executedPayments(adapter.paymentDigest(t)),"payment not recorded once"); require(token.balanceOf(recipient)>beforeToken,"no recipient output"); require(address(adapter).balance==0 && address(pool).balance==V-W,"ETH accounting"); (ok,)=submit(data); require(!ok,"same signed call replayed"); }
 function testReentrantProbeThenPoolAbortRollsBack() public { OperationRequest memory r=request(); PaymentTerms memory t=terms(r); bytes memory data=callData(r,t); pool.configureReentryProbes(data,true); bytes32 beforeHash=stateHash(); rejectUnchanged(data,adapter.paymentDigest(t)); require(stateHash()==beforeHash,"aborted probe changed assets"); require(!pool.payReentryRejected() && !pool.fallbackReentryRejected() && !pool.wrongEthReceiptRejected(),"aborted probe flags persisted"); }
 function testDirectEthReceiptIsRejected() public { bytes32 h=stateHash(); (bool ok,)=address(adapter).call{value:1}(""); require(!ok && stateHash()==h,"direct receipt"); }
 receive() external payable {}
}
