# Issue #36 Sepolia acceptance. Copy to .env and fill in local values.
# Source it in your shell before invoking the explicit Sepolia runner.
# The CLI reads owner/submitter keys from files with mode 0600.
# The runner prompts once on the terminal for the shared owner-store passphrase.
# Keep those files and mutable state under the ignored .sepolia-private/ directory.

SEPOLIA_RPC_URL=
POOL_MANIFEST_PATH=./.sepolia-private/pool-manifest.json
ALICE_KEY_PATH=./.sepolia-private/alice.key
BOB_KEY_PATH=./.sepolia-private/bob.key
SUBMITTER_KEY_PATH=./.sepolia-private/submitter.key
ALICE_STORE_PATH=./.sepolia-private/alice-store
BOB_STORE_PATH=./.sepolia-private/bob-store
SUBMITTER_JOURNAL_PATH=./.sepolia-private/submitter-journal
PUBLIC_RESULT_PATH=./tests/integration/core/results/sepolia-result.json

# Only needed when creating a new Pool/Verifier deployment with pnpm deploy:pool.
# The existing deployment script reads this key from the environment.
# POOL_DEPLOY_PRIVATE_KEY=
